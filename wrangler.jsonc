{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brian",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/twilio/*", "/mcp/*"]
  },
  // The database is created automatically on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "brian" }],
  // Every 15 minutes: refresh YouTube stats (hourly) and check the daily briefing call.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "BRIAN_MODEL": "claude-opus-5-5",
    "BRIAN_VOICE": "Polly.Brian-Neural",
    "SPEECH_LANGUAGE": "en-US",
    "TIMEZONE": "America/New_York"
  },
  "observability": { "enabled": true }
}
